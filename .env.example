# Copy to .env.local for local development. Keep real values out of Git.
# Set these privately in the hosting environment for a production server.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Public site URL, analytics, and verification settings are used at build time.
NEXT_PUBLIC_SITE_URL=https://ai8ht.pro
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
